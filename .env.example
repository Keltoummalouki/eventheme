# Local development works without these values; production writes are disabled without them.
EVENTHEME_DATA_MODE=local
# Set EVENTHEME_DATA_MODE=supabase only after applying the migration and importing content.
# /admin always requires a Supabase Auth account with app_metadata.role = "admin",
# even with local data: set the URL and publishable key to sign in at all.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: never use NEXT_PUBLIC_ for this value.
SUPABASE_SECRET_KEY=
APP_URL=http://localhost:3000

# E-mails automatiques (alerte à l'équipe, accusé de réception au client).
# Sans EMAIL_PROVIDER : en local, chaque e-mail est enregistré dans .eventheme/emails/
# pour relecture ; en production, aucun e-mail n'est envoyé.
EMAIL_PROVIDER=
# Server only: API key of the chosen provider (resend or brevo).
EMAIL_API_KEY=
# Expéditeur, sur un domaine vérifié chez le fournisseur (SPF et DKIM), ex. :
# EMAIL_FROM=EVENTHEMES <devis@votre-domaine.ma>
EMAIL_FROM=
# Destinataires des alertes, séparés par des virgules. Vide : l'adresse du lien
# « E-mail » de Contact & réseaux est utilisée.
EMAIL_TEAM=
