{
  "name": "eventhemes",
  "version": "0.1.0",
  "private": true,
  "description": "EVENTHEMES — site vitrine, catalogue de matériel technique et demandes de devis.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./tests/setup.mjs --test tests/*.test.ts",
    "test:coverage": "tsx --import ./tests/setup.mjs --test --experimental-test-coverage --test-coverage-include=src/lib/**/*.ts --test-coverage-include=src/data/**/*.ts --test-coverage-exclude=src/lib/motion.ts --test-coverage-exclude=src/lib/intro.ts --test-coverage-exclude=src/lib/images.ts --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=80 tests/*.test.ts",
    "test:e2e": "playwright test",
    "content:export": "tsx scripts/export-content.ts",
    "admin:role": "tsx scripts/admin-role.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sweetalert2": "^11.26.25",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.4",
    "tsx": "4.23.13",
    "typescript": "^5.9.3"
  }
}
